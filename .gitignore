# Local-only storage
local/

# Secrets and credentials
.env
.env.*
!.env.example
*.pem
*.key
credentials*.json
*.token

# Personal drafts and notes
drafts/
ai-notes/
LINKEDIN*.md
HOW_TO_USE*.md
PROMPT*.md
chat-export*

# Models and large binaries
models/
*.zip
*.pt
*.pth

# Videos (keep small example clips if needed)
videos/*.mp4
videos/*.gif
!videos/.gitkeep

# TensorBoard logs
results/tb/
results/*/tb_logs/
results/*/tensorboard/
**/tb_logs/
**/runs/

# Training process logs
results/logs/

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.venv/
venv/
env/
*.egg-info/
dist/
build/
.pytest_cache/
.mypy_cache/

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
*.swo
*.tmp
*.bak

# README assets (figures + demo GIFs, ~1.2 MB total) are intentionally
# tracked. Keep this block below the binary rules; never ignore assets/.
!assets/
!assets/**
